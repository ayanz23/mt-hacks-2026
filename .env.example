# Google service account used to write registrations to a Sheet and (optionally) resumes to Drive.
# See SETUP.md for how to create these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The ID from your Google Sheet's URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# The ID from your Drive folder's URL: https://drive.google.com/drive/folders/THIS_PART
# Only needed if you want resume uploads to work.
GOOGLE_DRIVE_RESUME_FOLDER_ID=
