# Google service account used to write registrations to a Sheet.
# See SETUP.md for how to create these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The ID from your Google Sheet's URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# OAuth client (Desktop app) used to upload resumes to your Drive. See SETUP.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Filled in automatically by: node scripts/get-drive-token.mjs
GOOGLE_OAUTH_REFRESH_TOKEN=

# The ID from your resume folder's URL: https://drive.google.com/drive/folders/THIS_PART
GOOGLE_DRIVE_RESUME_FOLDER_ID=
